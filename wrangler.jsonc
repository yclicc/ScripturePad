{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scripturepad",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",

    // Without this, the asset layer answers every browser *navigation* with
    // index.html before the Worker runs — so /auth/signin rendered the SPA
    // (and its "no document at this address" page) instead of redirecting.
    // It only reproduces with browser headers: curl still saw the 302, which
    // makes it easy to misdiagnose.
    //
    // Document pages run the Worker first too, so it can inject the note's
    // title into the served HTML — link-preview crawlers never run JavaScript,
    // so a client-side title leaves every shared link showing a generic card.
    //
    // `/*` with negations rather than a per-path list: the ids are generated
    // slugs, so they cannot be enumerated. Negative patterns take precedence,
    // and hashed bundles and the favicon are served straight from the asset
    // layer without touching the Worker.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/*.png",
      "!/*.ico",
      "!/*.svg",
      "!/*.css",
      "!/*.js",
      "!/*.woff2"
    ]
  },

  "observability": {
    "enabled": true
  },

  // Pinned so the local URL never moves. It is also the port registered as an
  // OAuth redirect (http://localhost:8787/auth/callback), which breaks if the
  // dev server lands somewhere else.
  "dev": {
    "port": 8787
  },

  // `custom_domain: true` rather than a plain route, because a route only
  // intercepts traffic that already resolves — it does not create DNS. With
  // the old Deno records deleted and nothing in their place, routes deployed
  // successfully but the hostname resolved to nothing at all. A custom domain
  // makes Cloudflare create and manage the DNS record itself.
  "routes": [
    { "pattern": "scripturepad.org", "custom_domain": true },
    { "pattern": "www.scripturepad.org", "custom_domain": true }
  ],

  // D1 holds documents and ownership. Create with:
  //   npx wrangler d1 create scripturepad
  // then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scripturepad",
      "database_id": "bd2ba684-c5a5-4906-800e-1cdb361b904a",
      "migrations_dir": "migrations"
    }
  ],

  // KV caches YouVersion version/language metadata (read-heavy, rarely
  // written). Create with:
  //   npx wrangler kv namespace create BIBLE_CACHE
  "kv_namespaces": [
    {
      "binding": "BIBLE_CACHE",
      "id": "7f9d81531677414ba0632a867f1d3b3d"
    }
  ]

  // Secrets are NOT set here. Use `wrangler secret put <NAME>`:
  //   YOUVERSION_APP_KEY, YOUVERSION_CLIENT_ID, SESSION_SECRET
  // For local dev, put them in .dev.vars (gitignored).
}
