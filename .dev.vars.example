# Copy to `.dev.vars` (gitignored) for local development.
# In production these are set with `wrangler secret put <NAME>`.

# YouVersion Platform app key, from https://platform.youversion.com
# Server-side only — this must never be sent to the browser.
YOUVERSION_APP_KEY="your-app-key"

# OAuth client_id. Leave blank — YouVersion uses the app key above as the
# client_id, so there is no second credential to obtain. What you DO need to
# register at platform.youversion.com is the callback URL, which must match
# the redirect_uri exactly:
#   http://localhost:8787/auth/callback   (local development)
#   https://scripturepad.org/auth/callback (production)
YOUVERSION_CLIENT_ID=""

# Random string used to sign session cookies, e.g. `openssl rand -base64 32`.
SESSION_SECRET="generate-a-random-value"
